# Author: Andrii Sadovskyi <andrii.sadovskyi@gmail.com>
#
# - Ignores sensitive environment files, OS metadata, and large binaries.
# - Official Docs: https://git-scm.com/docs/gitignore


# Environment variables containing sensitive keys or credentials
.env
.env.local
.env.*.local

# Operating System metadata files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Docker volumes, data directories, and temporary files
*.log
*.tmp
*.swp
data/

# Large Language Model weight files (GGUF binaries)
*.gguf
*.bin

# IDE-specific files
.vscode/
.idea/

---
Author: Andrii Sadovskyi &lt;andrii.sadovskyi@gmail.com&gt;
