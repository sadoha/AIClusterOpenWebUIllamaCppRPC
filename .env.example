# Author: Andrii Sadovskyi <andrii.sadovskyi@gmail.com>
#
# - Defines environment variables for the Docker Compose stack.
# - Copy this file to .env and fill in your secrets.
# - Official Docs: https://docs.docker.com/compose/environment-variables/

# ---------------------------------------------------------
# User/Group IDs for non-root execution
# Docs: https://docs.docker.com/engine/reference/run/#user
# ---------------------------------------------------------
UID=1000
GID=1000

# ---------------------------------------------------------
# Required for model download (Hugging Face gated model access)
# Docs: https://huggingface.co/docs/hub/security-tokens
# ---------------------------------------------------------
HF_TOKEN=hf_replace_with_your_token

# ---------------------------------------------------------
# Target architecture (Apple Silicon M2 Pro uses linux/arm64)
# Docs: https://docs.docker.com/build/building/multi-platform/
# ---------------------------------------------------------
DOCKER_PLATFORM=linux/arm64

# ---------------------------------------------------------
# Pinned upstream source and image versions
# Docs: https://docs.docker.com/develop/develop-images/dockerfile_best-practices/
# ---------------------------------------------------------
ALPINE_VERSION=3.22
# llama.cpp release b10217
LLAMA_CPP_REF=ddd4ec1428a6201e18975ea52b07c71e0f9aef26
OPEN_WEBUI_VERSION=v0.11.0
HERMES_AGENT_VERSION=v2026.7.30

# ---------------------------------------------------------
# Model Configuration
# ---------------------------------------------------------
MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
MODEL_DOWNLOAD_URL=https://huggingface.co/ggml-org/gemma-3-1b-it-GGUF/resolve/main/gemma-3-1b-it-Q4_K_M.gguf

# ---------------------------------------------------------
# llama.cpp runtime tuning
# Docs: https://github.com/ggml-org/llama.cpp/tree/master/tools/server
# ---------------------------------------------------------
# Context size for the LLM. Larger values consume more RAM.
LLAMA_CTX_SIZE=65536
# Number of threads for llama.cpp. For M2 Pro (e.g., 10-12 cores),
# 4-8 threads is a good starting point. Adjust based on model and system load.
LLAMA_THREADS=4

# ---------------------------------------------------------
# Resource Limits (tuned for a 16GB Apple Silicon M2 Pro)
# Docs: https://docs.docker.com/compose/compose-file/deploy/#resources
# ---------------------------------------------------------
LLAMA_HEAD_CPUS=2
LLAMA_HEAD_MEMORY=4G
LLAMA_WORKER_CPUS=4
LLAMA_WORKER_MEMORY=4G
WEBUI_CPUS=1
WEBUI_MEMORY=1G
HERMES_CPUS=1
HERMES_MEMORY=1G

# ---------------------------------------------------------
# Open WebUI Configuration
# Docs: https://docs.openwebui.com/getting-started/
# ---------------------------------------------------------
# A secret key for signing session data. Generate a long, random string.
WEBUI_SECRET_KEY=replace_with_long_random_secret

# ---------------------------------------------------------
# Hermes model bootstrap values for custom endpoint mode
# Docs: https://hermes-agent.nousresearch.com/docs/integrations/providers
# ---------------------------------------------------------
HERMES_MODEL_ID=gemma-3-1b-it-Q4_K_M
HERMES_CONTEXT_LENGTH=65536
HERMES_MODEL_API_KEY=none

# ---------------------------------------------------------
# Hermes gateway/API security
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/docker
# ---------------------------------------------------------
# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
# Keep disabled unless you explicitly need the OpenAI-compatible Hermes API.
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_KEY=replace_with_a_long_random_secret

# Explicit gateway user policy defaults.
# Keep false for deny-by-default behavior; set true only if you intentionally want a public Telegram bot.
# Set a real Telegram user ID to grant access only to that account. The default `0` grants access to nobody.
# Example for Telegram: TELEGRAM_ALLOWED_USERS=123456789
GATEWAY_ALLOW_ALL_USERS=false
TELEGRAM_ALLOWED_USERS=0

# ---------------------------------------------------------
# Service Port Mappings
# Docs: https://docs.docker.com/compose/compose-file/05-services/#ports
# ---------------------------------------------------------
LLAMA_SERVER_HEAD_PORT=127.0.0.1:8080
OPEN_WEBUI_PORT=127.0.0.1:3000
HERMES_API_PORT=127.0.0.1:8642
HERMES_DASHBOARD_PORT=127.0.0.1:9119

# ---------------------------------------------------------
# Hermes dashboard basic auth (required when dashboard binds non-loopback)
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard#authentication-gated-mode
# ---------------------------------------------------------
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace_with_strong_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace_with_long_random_secret
