# ---------------------------------------------------------
# Required for model download (Hugging Face gated model access)
# Docs: https://huggingface.co/docs/hub/security-tokens
# ---------------------------------------------------------
HF_TOKEN=hf_replace_with_your_token

# ---------------------------------------------------------
# Target architecture (Raspberry Pi 5 uses linux/arm64)
# Docs: https://docs.docker.com/build/building/multi-platform/
# ---------------------------------------------------------
DOCKER_PLATFORM=linux/arm64

# ---------------------------------------------------------
# llama.cpp runtime tuning
# Docs: https://github.com/ggml-org/llama.cpp/tree/master/tools/server
# ---------------------------------------------------------
LLAMA_CTX_SIZE=65536
LLAMA_THREADS=4

# ---------------------------------------------------------
# Hermes model bootstrap values for custom endpoint mode
# Docs: https://hermes-agent.nousresearch.com/docs/integrations/providers
# ---------------------------------------------------------
HERMES_MODEL_ID=gemma-3-1b-it-Q4_K_M
HERMES_CONTEXT_LENGTH=65536
HERMES_MODEL_API_KEY=none

# ---------------------------------------------------------
# Hermes gateway/API security
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/docker
# ---------------------------------------------------------
# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
# Keep disabled unless you explicitly need the OpenAI-compatible Hermes API.
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_KEY=replace_with_a_long_random_secret

# Explicit gateway user policy defaults.
# Keep false for deny-by-default behavior; set true to allow all Telegram users.
# Set a real Telegram user ID to grant access only to that account. The default `0` grants access to nobody.
# Example for Telegram: TELEGRAM_ALLOWED_USERS=123456789
GATEWAY_ALLOW_ALL_USERS=true
TELEGRAM_ALLOWED_USERS=0

# ---------------------------------------------------------
# Hermes dashboard basic auth (required when dashboard binds non-loopback)
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard#authentication-gated-mode
# ---------------------------------------------------------
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace_with_strong_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace_with_long_random_secret
